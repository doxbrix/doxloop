{
  "name": "@doxbrix/doxloop",
  "version": "0.1.5",
  "description": "A local-first documentation agent CLI for Codex, Claude Code, and Gemini.",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doxbrix/doxloop.git"
  },
  "homepage": "https://github.com/doxbrix/doxloop#readme",
  "bugs": {
    "url": "https://github.com/doxbrix/doxloop/issues"
  },
  "bin": {
    "doxloop": "dist/cli.js"
  },
  "files": [
    "dist",
    "assets",
    "contracts",
    "docs",
    "scripts/test-auto-screenshot.mjs",
    "skills/doxloop-authoring",
    "skills/doxloop-doxbrix",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE",
    "!dist/**/*.map",
    "!assets/marketing/**",
    "!assets/social/**"
  ],
  "exports": {
    "./generator-api": {
      "types": "./dist/generator-api.d.ts",
      "import": "./dist/generator-api.js"
    },
    "./generator-runtime": {
      "types": "./dist/generator-runtime.d.ts",
      "import": "./dist/generator-runtime.js"
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "scripts": {
    "build": "pnpm run build:core && pnpm run build:generators",
    "build:core": "rm -rf dist && tsc -p tsconfig.json && vite build --config vite.ui.config.ts && node scripts/prepare-dist.mjs",
    "build:generators": "pnpm --filter './packages/*' run build",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.ui.json && pnpm --filter './packages/*' run typecheck",
    "build:test": "tsc -p tsconfig.json && pnpm run build:generators",
    "pretest": "pnpm run build:test",
    "test": "vitest run",
    "test:generator": "node scripts/ci-generator-smoke.mjs",
    "test:screenshot": "node scripts/test-auto-screenshot.mjs",
    "test:e2e": "playwright test",
    "eval:agents": "pnpm run build && node scripts/run-authoring-evals.mjs",
    "check": "pnpm run typecheck && pnpm run test && pnpm run validate:skill && pnpm run check:boundary",
    "release:local": "node scripts/release-local.mjs",
    "validate:skill": "node scripts/validate-skills.mjs",
    "check:boundary": "node scripts/check-boundary.mjs",
    "prepack": "pnpm run check && pnpm run build && pnpm run check:boundary",
    "test:existing-sites": "node scripts/ci-existing-sites.mjs",
    "test:python-boundary": "node scripts/ci-python-sandbox.mjs"
  },
  "dependencies": {
    "@playwright/mcp": "0.0.79",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "axe-core": "^4.13.0",
    "chokidar": "^4.0.3",
    "cross-spawn": "^7.0.6",
    "fflate": "^0.8.2",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.11.1",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@doxbrix/doxloop-generator-docusaurus": "workspace:*",
    "@doxbrix/doxloop-generator-hugo": "workspace:*",
    "@doxbrix/doxloop-generator-jekyll": "workspace:*",
    "@doxbrix/doxloop-generator-markdoc": "workspace:*",
    "@doxbrix/doxloop-generator-mkdocs": "workspace:*",
    "@doxbrix/doxloop-generator-nextra": "workspace:*",
    "@doxbrix/doxloop-generator-sphinx": "workspace:*",
    "@doxbrix/doxloop-generator-starlight": "workspace:*",
    "@doxbrix/doxloop-generator-static": "workspace:*",
    "@doxbrix/doxloop-generator-vitepress": "workspace:*",
    "@playwright/test": "^1.62.1",
    "@preact/preset-vite": "^2.10.2",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^22.15.3",
    "@types/pngjs": "^6.0.5",
    "preact": "^10.27.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^7.3.1",
    "vitest": "^3.1.2"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@10.33.0",
  "keywords": [
    "documentation",
    "documentation-maintenance",
    "cli",
    "markdown",
    "docusaurus",
    "mkdocs"
  ],
  "author": "Doxbrix"
}
